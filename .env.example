# ==============================================================================
# Vasudha Polymer VTMS Mobile App - Environment Configuration Template
# Copy this file to .env and configure your backend endpoint.
# ==============================================================================

# Backend REST API Base URL
# In Expo SDK 49+, environment variables exposed to mobile JS must start with EXPO_PUBLIC_
#
# Option 1 (Local Testing with Physical Device over Wi-Fi):
# EXPO_PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:5000/api/v1
#
# Option 2 (Production / Hosted Cloud Server):
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
#
# NOTE: If EXPO_PUBLIC_API_URL is omitted or empty, the app automatically
# detects your host machine's Metro IP address dynamically.

# Mobile App Branding (Displayed on login and top shell)
EXPO_PUBLIC_COMPANY_NAME="Vasudha Polymer"
